# Banco de dados (bate com o docker-compose.yml)
DATABASE_URL=postgresql+psycopg2://loterias:loterias@localhost:5432/loterias

# NVIDIA NIM Vision
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.2-90b-vision-instruct

# Armazenamento local dos bilhetes
STORAGE_DIR=storage/tickets

# Segmentação (recorte automático de cada bilhete antes do OCR)
SEGMENTATION_ENABLED=true
SEGMENTATION_MIN_AREA_FRAC=0.03
SEGMENTATION_UPSCALE_TO=1400

# Scraper da Caixa
CAIXA_HEADLESS=true
CAIXA_TIMEOUT_MS=30000
